package-as: Levelbound

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibSharedMedia-3.0: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  Libs/LibDataBroker-1.1: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDataBroker-1.1
  Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
  Libs/ChatThrottleLib: https://repos.wowace.com/wow/chatthrottlelib/trunk
  Libs/LibAeonSettings:
    url: https://github.com/Aeon234/LibAeonSettings.git
    tag: 1.1.0

ignore:
  - .pkgmeta
  - .wowluarc.json
  - .github
  - Tools
  - Dev
  - "*.md"
  - Libs/AeonSettings/PIN.json
