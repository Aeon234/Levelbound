<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="LevelboundSettings_DropdownTemplate" mixin="LevelboundSettings_DropdownMixin" virtual="true">
		<Size x="220" y="29"/>
		<Frames>
			<Frame parentKey="Motion">
				<Size x="220" y="29"/>
				<Anchors>
					<Anchor point="CENTER"/>
				</Anchors>
				<Frames>
					<Button parentKey="Play" hidden="true">
						<Size x="24" y="24"/>
						<Anchors>
							<Anchor point="LEFT"/>
						</Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<Texture parentKey="Icon" atlas="voicechat-icon-speaker">
									<Size x="20" y="20"/>
									<Anchors>
										<Anchor point="CENTER"/>
									</Anchors>
								</Texture>
							</Layer>
						</Layers>
					</Button>
					<DropdownButton parentKey="Dropdown" inherits="WowStyle1DropdownTemplate">
						<Anchors>
							<Anchor point="RIGHT"/>
						</Anchors>
						<Layers>
							<Layer level="ARTWORK" textureSubLevel="-1">
								<Texture parentKey="Sample" hidden="true"/>
							</Layer>
						</Layers>
					</DropdownButton>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</Frame>
</Ui>
