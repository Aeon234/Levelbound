<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="LevelboundSettings_SettingRowTemplate" mixin="LevelboundSettings_SettingRowMixin" virtual="true">
		<Size y="50"/>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="0">
				<Texture parentKey="Band" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Guide" hidden="true">
					<Size x="1"/>
				</Texture>
				<Texture parentKey="Divider" hidden="true">
					<Size x="1"/>
					<Anchors>
						<Anchor point="TOP"/>
						<Anchor point="BOTTOM"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="First"/>
			<Frame parentKey="Second" hidden="true"/>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnHide method="ClearHover"/>
		</Scripts>
	</Frame>
</Ui>
