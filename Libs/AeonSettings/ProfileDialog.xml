<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="LevelboundSettings_ProfileDialogTemplate" mixin="LevelboundSettings_ProfileDialogMixin" inherits="SettingsFrameTemplate" frameStrata="DIALOG" toplevel="true" movable="true" clampedToScreen="true" enableMouse="true" hidden="true" virtual="true">
		<Frames>
			<Frame parentKey="Body">
				<Anchors>
					<Anchor point="TOPLEFT" x="18" y="-34"/>
					<Anchor point="BOTTOMRIGHT" x="-18" y="16"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Message" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP"/>
						<FontString parentKey="Summary" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
							<Size y="16"/>
						</FontString>
						<FontString parentKey="Error" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
							<Size y="16"/>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Frame parentKey="Well" inherits="TooltipBackdropTemplate">
						<Size y="180"/>
						<Frames>
							<Frame parentKey="Scroll" inherits="ScrollingEditBoxTemplate">
								<Anchors>
									<Anchor point="TOPLEFT" x="8" y="-8"/>
									<Anchor point="BOTTOMRIGHT" x="-22" y="8"/>
								</Anchors>
							</Frame>
							<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
								<Anchors>
									<Anchor point="TOPLEFT" relativeKey="$parent.Scroll" relativePoint="TOPRIGHT" x="6" y="0"/>
									<Anchor point="BOTTOMLEFT" relativeKey="$parent.Scroll" relativePoint="BOTTOMRIGHT" x="6" y="0"/>
								</Anchors>
							</EventFrame>
						</Frames>
					</Frame>
					<EditBox parentKey="Name" inherits="InputBoxInstructionsTemplate" autoFocus="false" letters="32">
						<Size y="22"/>
					</EditBox>
					<DropdownButton parentKey="Choice" inherits="WowStyle1DropdownTemplate">
						<Size x="256"/>
					</DropdownButton>
					<Button parentKey="Cancel" inherits="SharedButtonTemplate">
						<Size x="120" y="26"/>
						<Anchors>
							<Anchor point="BOTTOMRIGHT"/>
						</Anchors>
					</Button>
					<Button parentKey="Accept" inherits="SharedButtonTemplate">
						<Size x="120" y="26"/>
						<Anchors>
							<Anchor point="RIGHT" relativeKey="$parent.Cancel" relativePoint="LEFT" x="-8" y="0"/>
						</Anchors>
					</Button>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</Frame>
</Ui>
