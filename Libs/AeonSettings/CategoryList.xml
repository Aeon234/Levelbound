<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Button name="LevelboundSettings_CategoryHeaderTemplate" inherits="ListHeaderVisualTemplate" mixin="LevelboundSettings_CategoryHeaderMixin" registerForClicks="LeftButtonUp" virtual="true">
		<Size y="26"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Icon" hidden="true">
					<Size x="16" y="16"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Button name="LevelboundSettings_CategoryPageTemplate" mixin="LevelboundSettings_CategoryPageMixin" registerForClicks="LeftButtonUp" virtual="true">
		<Size y="20"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" hidden="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Icon" hidden="true">
					<Size x="16" y="16"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Frame name="LevelboundSettings_CategoryListTemplate" mixin="LevelboundSettings_CategoryListMixin" virtual="true">
		<Frames>
			<Frame parentKey="ScrollBox" inherits="WowScrollBoxList"/>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar"/>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
