<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Button name="LevelboundSettings_SearchDividerTemplate" mixin="LevelboundSettings_SearchDividerMixin" registerForClicks="LeftButtonUp" virtual="true">
		<Size y="36"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="MouseoverOverlay" alphaMode="ADD" hidden="true" setAllPoints="true">
					<Color r="0.1" g="0.1" b="0.1" a="1"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Title" inherits="GameFontNormalLarge" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" x="16"/>
						<Anchor point="RIGHT" x="-16"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Frame name="LevelboundSettings_WindowTemplate" inherits="SettingsFrameTemplate" mixin="LevelboundSettings_WindowMixin" toplevel="true" movable="true" enableMouse="true" clampedToScreen="true" frameStrata="HIGH" hidden="true" virtual="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="ReloadNotice" inherits="GameFontHighlight" justifyH="LEFT" hidden="true"/>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="EditModeButton" inherits="MainMenuFrameButtonTemplate" hidden="true"/>
			<Frame parentKey="Categories" inherits="LevelboundSettings_CategoryListTemplate"/>
			<Frame parentKey="Page">
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Empty" inherits="GameFontDisableLarge" hidden="true">
							<Anchors>
								<Anchor point="TOP" y="-94"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Frame parentKey="Header">
						<Size y="50"/>
						<Anchors>
							<Anchor point="TOPLEFT"/>
							<Anchor point="TOPRIGHT"/>
						</Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<FontString parentKey="Title" inherits="GameFontHighlightHuge" justifyH="LEFT" wordwrap="false">
									<Anchors>
										<Anchor point="TOPLEFT" x="7" y="-22"/>
									</Anchors>
								</FontString>
								<Texture parentKey="Divider" atlas="Options_HorizontalDivider" useAtlasSize="true">
									<Anchors>
										<Anchor point="TOP" y="-50"/>
									</Anchors>
								</Texture>
							</Layer>
						</Layers>
						<Frames>
							<Button parentKey="DefaultsButton" inherits="SharedButtonTemplate">
								<Size x="120" y="24"/>
								<Anchors>
									<Anchor point="RIGHT" relativePoint="TOPRIGHT" x="-36" y="-27"/>
								</Anchors>
							</Button>
							<DropdownButton parentKey="JumpDropdown" inherits="WowStyle1ArrowDropdownTemplate" hidden="true">
								<Anchors>
									<Anchor point="LEFT" relativeKey="$parent.Title" relativePoint="RIGHT" x="8" y="0"/>
								</Anchors>
							</DropdownButton>
						</Frames>
					</Frame>
					<Frame parentKey="Preview" inherits="LevelboundSettings_PreviewPanelTemplate"/>
					<Frame parentKey="ScrollBox" inherits="WowScrollBoxList"/>
					<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar"/>
				</Frames>
			</Frame>
			<EditBox parentKey="SearchBox" name="$parentSearchBox" inherits="SearchBoxTemplate">
				<Size x="350" y="22"/>
			</EditBox>
			<Frame parentKey="StatusFrame" hidden="true">
				<Size x="1" y="1"/>
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="Text" inherits="GameFontHighlight">
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			<Button parentKey="ReloadButton" inherits="MainMenuFrameButtonTemplate"/>
			<Button parentKey="CloseButton" inherits="MainMenuFrameButtonTemplate"/>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEvent method="OnEvent"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
		</Scripts>
	</Frame>
</Ui>
