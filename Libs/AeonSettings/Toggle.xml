<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Button name="LevelboundSettings_ToggleTemplate" mixin="LevelboundSettings_ToggleMixin" registerForClicks="LeftButtonUp" virtual="true">
		<Size x="56" y="28"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="TrackLeft">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="TrackRight">
					<Anchors>
						<Anchor point="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="TrackMiddle">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.TrackLeft" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.TrackRight" relativePoint="BOTTOMLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="Pin">
				<Layers>
					<Layer level="ARTWORK">
						<Texture parentKey="Circle" atlas="common-radiobutton-circle" setAllPoints="true"/>
					</Layer>
					<Layer level="OVERLAY" textureSubLevel="0">
						<Texture parentKey="Dot" atlas="common-radiobutton-dot" setAllPoints="true"/>
					</Layer>
					<Layer level="OVERLAY" textureSubLevel="1">
						<Texture parentKey="Highlight" atlas="common-radiobutton-circle" alphaMode="ADD" setAllPoints="true" hidden="true"/>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</Button>
</Ui>
