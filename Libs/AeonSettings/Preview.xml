<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="LevelboundSettings_PreviewPanelTemplate" mixin="LevelboundSettings_PreviewPanelMixin" hidden="true" virtual="true">
		<Frames>
			<Button parentKey="Band" registerForClicks="LeftButtonUp">
				<Size y="36"/>
				<Anchors>
					<Anchor point="TOPLEFT"/>
					<Anchor point="TOPRIGHT"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Title" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false"/>
						<FontString parentKey="Hint" inherits="GameFontHighlightSmall" justifyH="RIGHT" wordwrap="false"/>
						<Texture parentKey="Toggle"/>
					</Layer>
				</Layers>
				<Frames>
					<Frame parentKey="StateSlot">
						<Size x="256" y="26"/>
					</Frame>
				</Frames>
			</Button>
			<Frame parentKey="Body">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Band" relativePoint="BOTTOMLEFT"/>
					<Anchor point="TOPRIGHT" relativeKey="$parent.Band" relativePoint="BOTTOMRIGHT"/>
				</Anchors>
				<Frames>
					<Frame parentKey="Room"/>
					<Frame parentKey="Sample"/>
					<Frame parentKey="Hits"/>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
