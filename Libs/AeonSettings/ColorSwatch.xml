<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="LevelboundSettings_ColorSwatchTemplate" mixin="LevelboundSettings_ColorSwatchMixin" virtual="true">
		<Size x="30" y="30"/>
		<Frames>
			<Button parentKey="Swatch" registerForClicks="LeftButtonUp">
				<Size x="30" y="30"/>
				<Anchors>
					<Anchor point="CENTER"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Border" setAllPoints="true"/>
					</Layer>
					<Layer level="ARTWORK" textureSubLevel="1">
						<Texture parentKey="Color"/>
					</Layer>
					<Layer level="OVERLAY">
						<Texture parentKey="Highlight" hidden="true"/>
					</Layer>
				</Layers>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</Frame>
</Ui>
