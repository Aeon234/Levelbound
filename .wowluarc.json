{
  "$schema": "https://raw.githubusercontent.com/TradeSkillMaster/wowlua-ls/main/editors/vscode/wowluarc.schema.json",

  "library": ["Libs/"],
  "flavors": ["retail"],

  "globals": {
    "read": ["LibStub", "ChatThrottleLib", "SlashCmdList", "StaticPopupDialogs", "WOW_PROJECT_CAMELOT"],
    "write": ["Levelbound*", "SlashCmdList"]
  },

  "diagnostics": {
    "enable": [
      "need-check-nil",
      "nil-index",
      "invalid-op",
      "redundant-condition",
      "redundant-and",
      "redundant-or",
      "unused-function",
      "unused-vararg"
    ]
  }
}
